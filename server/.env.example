# =============================================================================
# 光阴对弈 / 光阴对赌 服务端生产环境配置模板（SiliconFlow 单密钥通用版）
# =============================================================================
# 复制本文件为 server/.env（本地开发）或服务器部署目录下的 .env，只需填好下面前 2 项即可：
#   1. ADMIN_TOKEN         管理员后台登录与图片上传密钥（请换成长随机字符串，等号两侧勿留空格）
#   2. SILICONFLOW_API_KEY 硅基流动 API Key —— 全站共用这一把密钥：
#                          产品版 AI 玩家 + 6AI 实验室 + 规则助手 全部共用！
# =============================================================================

# -----------------------------------------------------------------------------
# 一、必填核心配置（上线前只需改以下 2 项）
# -----------------------------------------------------------------------------
ADMIN_TOKEN=replace-with-a-long-random-secret
SILICONFLOW_API_KEY=sk-siliconflow-placeholder

# 硅基流动兼容接口与默认首选模型（通常无需改动）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# 可选：CORS 跨域白名单（逗号分隔）；生产默认已包含玩家主域与管理子域
# ALLOWED_ORIGINS=https://guangyinduidu.com,https://admin.guangyinduidu.com
# 可选：前端版本强校验（部署后要求客户端 version.json 的 buildId 一致）
# REQUIRED_CLIENT_BUILD_ID=

# -----------------------------------------------------------------------------
# 二、规则助手（自动共用上面的 SILICONFLOW_API_KEY，无需再填第二个密钥）
# -----------------------------------------------------------------------------
RULE_AGENT_ENABLED=true
RULE_AGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# -----------------------------------------------------------------------------
# 三、AI 玩家（C 端产品版 — 自动共用 SILICONFLOW_API_KEY 并按座位分配 5 家高速模型）
# -----------------------------------------------------------------------------
# 默认 1～5 号 AI 座位自动分配实测高速国产模型（已避开不稳定的旧模型）：
#   DeepSeek-V4.1-Flash / Qwen3.8-27B / GLM-5.3 / Kimi-K2.7-Code / Hy4-preview
# 若需单独指定某席位模型，可在管理端网页实时切换，或按需补充 AI_PLAYER_1_MODEL=...（无需多把 Key）。
AI_PLAYERS_ENABLED=true
AI_STRICT_AGENT=true
AI_AUTOFILL_TARGET=6
AI_TEMPERATURE=0.7
AI_DISABLE_THINKING=false

# 单次决策超时（毫秒） / 重试 / 输出上限 / 每名 AI 每局 token 预算（0 表示不限）
AI_DECISION_TIMEOUT_MS=35000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=32000
AI_TOKEN_BUDGET_PER_GAME=0
AI_MAX_TURN_MS=90000
AI_MAX_CONCURRENT=5
AI_MAX_PER_ROOM=5

# AI 行为开关与拟人节奏
AI_CHAT_ENABLED=true
AI_TRANSFER_ENABLED=true
AI_COFFEE_ENABLED=true
AI_BUFF_ENABLED=true
AI_AUCTION_ENABLED=true
AI_ACTION_DELAY_MIN_MS=250
AI_ACTION_DELAY_MAX_MS=900
AI_AUCTION_MAX_DECISIONS=3
AI_VERBOSE_LOG=false
AI_SAFETY_ENABLED=true

# -----------------------------------------------------------------------------
# 四、6AI 实验室 — 默认 6 家实测高速模型阵容（同样共用 SILICONFLOW_API_KEY）
# -----------------------------------------------------------------------------
LAB_PLAYER_1_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LAB_PLAYER_2_MODEL=Qwen/Qwen3.8-27B
LAB_PLAYER_3_MODEL=zai-org/GLM-5.3
LAB_PLAYER_4_MODEL=moonshotai/Kimi-K2.7-Code
LAB_PLAYER_5_MODEL=tencent/Hy4-preview
LAB_PLAYER_6_MODEL=meituan-longcat/LongCat-2.0

# -----------------------------------------------------------------------------
# 五、系统自动主持、彩票随机源与终局社交评定
# -----------------------------------------------------------------------------
AUTO_HOST_ENABLED=true
AUTO_START_DELAY_MS=30000
AUTO_START_MIN_PLAYERS=1
AUTO_PHASE_REMINDER_MS=90000
AUTO_INTRO_MS=12000
AUTO_SETTLEMENT_MS=15000
AUTO_AUCTION_IDLE_MS=12000
AUTO_AUCTION_LOT_MS=40000
AUTO_NAMING_MS=45000
AUTO_LOTTERY_CONFIRM_MS=30000

LOTTERY_ONLINE_RANDOM=true
LOTTERY_RANDOM_TIMEOUT_MS=2500

SOCIAL_AUTO_SCORE=true
