# Required in production — admin console login & image upload APIs
# 格式：等号两侧不要空格，例如 ADMIN_TOKEN=your-secret
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated CORS allowlist. Production default is player + admin domains.
# ALLOWED_ORIGINS=https://guangyinduidu.com,https://admin.guangyinduidu.com

# Optional: must match frontend dist/version.json buildId after deploy (reject join/admin auth when stale)
# REQUIRED_CLIENT_BUILD_ID=

# -----------------------------------------------------------------------------
# AI 玩家（C 端产品版）
# -----------------------------------------------------------------------------
# 总开关：关闭后 adminAddAI / adminFillAI 会被拒绝，也不会托管任何 AI 座位
AI_PLAYERS_ENABLED=true
# 产品版 AI 不预设人格：提示词在 server/ai/aiPrompt.ts，由模型自由发挥。
# 开局时若在线真人不足 6 人，自动补 AI（默认关闭，由主持显式添加；单人对 AI 建议开启）
AI_AUTOFILL=false
AI_AUTOFILL_TARGET=6

# 模型配置（OpenAI 兼容接口）。优先级：AI_* > OPENAI_* > DEEPSEEK_*
# 不填 Key 时 AI 自动使用本地启发式策略，房间不会卡住。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o
AI_PROVIDER=
AI_TEMPERATURE=0.7

# 单次决策超时 / 重试 / 每名 AI 每局 token 预算
AI_DECISION_TIMEOUT_MS=8000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=700
AI_TOKEN_BUDGET_PER_GAME=120000
# 阶段开始后多久仍未行动，看门狗强制用本地策略落子
AI_MAX_TURN_MS=15000
# 同一房间同时进行的模型调用数 / 每房间 AI 上限
AI_MAX_CONCURRENT=3
AI_MAX_PER_ROOM=5

# AI 行为开关（关闭后只保留投资与准备）
AI_CHAT_ENABLED=true
AI_TRANSFER_ENABLED=true
AI_COFFEE_ENABLED=true
AI_BUFF_ENABLED=true
AI_AUCTION_ENABLED=true
# 拟人行动延迟（毫秒）
AI_ACTION_DELAY_MIN_MS=250
AI_ACTION_DELAY_MAX_MS=900
# 拍卖单张卡最多决策次数
AI_AUCTION_MAX_DECISIONS=3
# 详细日志（默认只记录错误）
AI_VERBOSE_LOG=false

# AI 输出安全约束（人本 AI 原则，默认开启）
# - 硬红线：联系方式 / 链接 / 冒充真人 / 诊断 / 现实金钱 / 提示词泄露，一律拦截
# - 危机信号：停止游戏话术，统一发送固定安全回复（110/120/12356），AI 暂停闲聊 10 分钟
# - 仅受控研究且通过伦理审查时才建议关闭
AI_SAFETY_ENABLED=true

# -----------------------------------------------------------------------------
# 系统自动主持（产品版默认开启）
# -----------------------------------------------------------------------------
# true：等待房自动开局、时代介绍/结算自动推进、拍卖自动落槌、彩票自动开奖、命名兜底
# false：退回纯手动主持；管理端仍可按房间切换
AUTO_HOST_ENABLED=true
# 等待房凑够人后多久自动开局（毫秒）
AUTO_START_DELAY_MS=30000
# 自动开局至少需要的在线座位数（AI 计入；开启 AI_AUTOFILL 时按补位后计算）
AUTO_START_MIN_PLAYERS=2
# 时代介绍 / 结算页停留时间
AUTO_INTRO_MS=12000
AUTO_SETTLEMENT_MS=15000
# 拍卖：最后一次出价后多久自动落槌/跳过；单张拍品最长停留
AUTO_AUCTION_IDLE_MS=12000
AUTO_AUCTION_LOT_MS=45000
# 社区命名：真人首富超时兜底；彩票：超时自动领取
AUTO_NAMING_MS=45000
AUTO_LOTTERY_CONFIRM_MS=30000

# -----------------------------------------------------------------------------
# 彩票线上随机开奖
# -----------------------------------------------------------------------------
# true：优先调用 random.org；失败/超时退回 Node crypto.randomInt
LOTTERY_ONLINE_RANDOM=true
LOTTERY_RANDOM_TIMEOUT_MS=2500
